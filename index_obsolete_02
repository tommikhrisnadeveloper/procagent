<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ProcAgent — Agentic AI for Procurement</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #0E1A2B;
      color: #F4F8FC;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ── */
    .pa-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px;
      border-bottom: 1px solid rgba(74,210,245,0.18);
      background: rgba(14,26,43,0.95);
      backdrop-filter: blur(12px);
      flex-shrink: 0; z-index: 10;
    }
    .pa-logo { display: flex; align-items: center; gap: 10px; }
    .pa-logo-mark {
      width: 32px; height: 32px;
      background: linear-gradient(135deg, #025196, #4AD2F5);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Syne', sans-serif; font-weight: 800; font-size: 13px;
      color: white; letter-spacing: -0.5px;
    }
    .pa-logo-text { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 16px; }
    .pa-logo-text span { color: #4AD2F5; }
    .pa-badge {
      font-size: 10px;
      background: linear-gradient(90deg, #025196, #4AD2F5);
      padding: 2px 8px; border-radius: 20px;
      font-weight: 600; letter-spacing: 0.5px; color: white;
    }
    .pa-header-right { display: flex; align-items: center; gap: 16px; position: relative; }
    .pa-status { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #8B9DB5; }
    .pa-status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: #22c55e; box-shadow: 0 0 6px #22c55e;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }

    /* ── Token Counter ── */
    .pa-token-counter {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(74,210,245,0.18);
      border-radius: 8px; padding: 6px 10px;
      cursor: pointer; transition: all 0.15s;
      position: relative; user-select: none;
    }
    .pa-token-counter:hover { border-color: rgba(74,210,245,0.35); background: rgba(74,210,245,0.06); }
    .pa-token-counter.warning { border-color: rgba(253,179,56,0.4); }
    .pa-token-counter.danger  { border-color: rgba(232,35,42,0.5); animation: dangerPulse 2s ease-in-out infinite; }
    @keyframes dangerPulse { 0%,100%{box-shadow:none} 50%{box-shadow:0 0 10px rgba(232,35,42,0.3)} }
    .pa-token-icon { font-size: 13px; }
    .pa-token-main { display: flex; flex-direction: column; gap: 3px; }
    .pa-token-total {
      font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700;
      color: #F4F8FC; white-space: nowrap; display: flex; align-items: baseline; gap: 1px;
    }
    .pa-token-used { color: #4AD2F5; font-size: 13px; }
    .pa-token-used.warning { color: #FDB338 !important; }
    .pa-token-used.danger  { color: #E8232A !important; }
    .pa-token-sep { color: #4A5568; font-size: 11px; font-weight: 400; margin: 0 2px; }
    .pa-token-limit { color: #8B9DB5; font-size: 12px; }
    .pa-token-label { font-size: 11px; color: #4A5568; font-weight: 400; margin-left: 2px; }
    .pa-token-bar-wrap { width: 80px; height: 3px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden; }
    .pa-token-bar-fill {
      height: 100%; background: linear-gradient(90deg, #4AD2F5, #FDB338);
      border-radius: 2px; transition: width 0.4s ease; min-width: 2px;
    }
    .pa-token-bar-fill.warning { background: linear-gradient(90deg, #4AD2F5, #FDB338); }
    .pa-token-bar-fill.danger  { background: linear-gradient(90deg, #FDB338, #E8232A); }
    .pa-token-detail {
      position: absolute; top: calc(100% + 8px); right: 0;
      background: #0E1A2B; border: 1px solid rgba(74,210,245,0.18);
      border-radius: 10px; padding: 12px; min-width: 185px;
      z-index: 100; box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      display: none;
    }
    .pa-token-detail.open { display: block; }
    .pa-token-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12px; color: #8B9DB5; padding: 4px 0;
    }
    .pa-token-row.border-top { border-top: 1px solid rgba(74,210,245,0.18); margin-top: 4px; padding-top: 8px; }
    .pa-token-val { font-weight: 600; color: #F4F8FC; font-family: 'Syne', sans-serif; font-size: 12px; }
    .pa-token-val.in { color: #4AD2F5; }
    .pa-token-val.out { color: #FDB338; }
    .pa-token-val.warning { color: #FDB338 !important; }
    .pa-token-val.danger  { color: #E8232A !important; }
    .pa-token-warn-badge {
      font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; font-family: 'Syne', sans-serif;
    }
    .pa-token-warn-badge.warning { background: rgba(253,179,56,0.15); color: #FDB338; border: 1px solid rgba(253,179,56,0.3); }
    .pa-token-warn-badge.danger  { background: rgba(232,35,42,0.15);  color: #E8232A; border: 1px solid rgba(232,35,42,0.3); }
    .pa-token-alert { margin-top: 8px; padding: 7px 9px; border-radius: 6px; font-size: 11px; line-height: 1.4; }
    .pa-token-alert.warning { background: rgba(253,179,56,0.1); color: #FDB338; border: 1px solid rgba(253,179,56,0.2); }
    .pa-token-alert.danger  { background: rgba(232,35,42,0.1);  color: #E8232A; border: 1px solid rgba(232,35,42,0.2); }
    .pa-token-reset {
      margin-top: 10px; text-align: center; font-size: 11px; color: #E8232A;
      cursor: pointer; padding: 4px; border-radius: 4px;
      border: 1px solid rgba(232,35,42,0.2); transition: all 0.15s;
    }
    .pa-token-reset:hover { background: rgba(232,35,42,0.1); }

    /* ── Layout ── */
    .pa-body { display: flex; flex: 1; overflow: hidden; }

    /* ── Sidebar ── */
    .pa-sidebar {
      width: 220px; flex-shrink: 0;
      border-right: 1px solid rgba(74,210,245,0.18);
      padding: 16px 10px; overflow-y: auto;
      background: rgba(14,26,43,0.6);
    }
    .pa-sidebar::-webkit-scrollbar { width: 3px; }
    .pa-sidebar::-webkit-scrollbar-thumb { background: rgba(74,210,245,0.18); }
    .pa-sidebar-label {
      font-size: 10px; font-weight: 600; letter-spacing: 1.2px;
      color: #4A5568; padding: 0 8px 8px; text-transform: uppercase;
    }
    .pa-agent-btn {
      display: flex; align-items: center; gap: 9px;
      width: 100%; padding: 9px 10px;
      border: none; background: transparent; color: #8B9DB5;
      border-radius: 8px; cursor: pointer; transition: all 0.15s;
      text-align: left; font-family: 'DM Sans', sans-serif; font-size: 13px;
      margin-bottom: 2px; border-left: 2px solid transparent;
    }
    .pa-agent-btn:hover { background: rgba(2,81,150,0.12); color: #F4F8FC; }
    .pa-agent-btn.active {
      background: linear-gradient(90deg, rgba(2,81,150,0.4), rgba(74,210,245,0.1));
      color: #F4F8FC; border-left-color: var(--ac);
    }
    .pa-agent-icon { font-size: 15px; flex-shrink: 0; }
    .pa-agent-name { font-weight: 500; line-height: 1.2; }

    /* ── Main ── */
    .pa-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    .pa-agent-header {
      padding: 16px 24px 12px;
      border-bottom: 1px solid rgba(74,210,245,0.18);
      background: rgba(14,26,43,0.4); flex-shrink: 0;
    }
    .pa-agent-title {
      font-family: 'Syne', sans-serif; font-weight: 700; font-size: 17px;
      display: flex; align-items: center; gap: 10px;
    }
    .pa-agent-title-icon {
      width: 30px; height: 30px; border-radius: 7px;
      display: flex; align-items: center; justify-content: center; font-size: 15px;
    }
    .pa-agent-desc { font-size: 12px; color: #8B9DB5; margin-top: 3px; padding-left: 40px; }

    /* ── Messages ── */
    .pa-messages {
      flex: 1; overflow-y: auto; padding: 20px 24px;
      display: flex; flex-direction: column; gap: 16px; scroll-behavior: smooth;
    }
    .pa-messages::-webkit-scrollbar { width: 4px; }
    .pa-messages::-webkit-scrollbar-thumb { background: rgba(74,210,245,0.18); border-radius: 2px; }

    /* ── Welcome ── */
    .pa-welcome { margin: auto; text-align: center; max-width: 420px; padding: 40px 20px; }
    .pa-welcome-icon { font-size: 48px; margin-bottom: 16px; filter: drop-shadow(0 0 20px rgba(74,210,245,0.3)); }
    .pa-welcome h2 { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 22px; margin-bottom: 8px; }
    .pa-welcome h2 span { color: #4AD2F5; }
    .pa-welcome p { font-size: 14px; color: #8B9DB5; line-height: 1.6; margin-bottom: 24px; }
    .pa-quick-prompts { display: flex; flex-direction: column; gap: 8px; }
    .pa-quick-btn {
      background: rgba(2,81,150,0.12); border: 1px solid rgba(74,210,245,0.18);
      color: #CBD5E0; padding: 10px 16px; border-radius: 8px;
      cursor: pointer; font-size: 13px; font-family: 'DM Sans', sans-serif;
      text-align: left; transition: all 0.15s;
    }
    .pa-quick-btn:hover { background: rgba(2,81,150,0.25); color: #F4F8FC; border-color: #4AD2F5; }

    /* ── Bubbles ── */
    .pa-msg { display: flex; gap: 10px; max-width: 88%; }
    .pa-msg.user { flex-direction: row-reverse; align-self: flex-end; }
    .pa-msg.assistant { align-self: flex-start; }
    .pa-msg-avatar {
      width: 30px; height: 30px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; flex-shrink: 0; margin-top: 2px;
    }
    .pa-msg.assistant .pa-msg-avatar { background: linear-gradient(135deg, #025196, #4AD2F5); }
    .pa-msg.user .pa-msg-avatar { background: rgba(74,210,245,0.15); border: 1px solid rgba(74,210,245,0.18); }
    .pa-msg-bubble { padding: 12px 15px; border-radius: 12px; font-size: 13.5px; line-height: 1.65; }
    .pa-msg.user .pa-msg-bubble {
      background: linear-gradient(135deg, #025196, rgba(2,81,150,0.7));
      color: white; border-bottom-right-radius: 3px;
    }
    .pa-msg.assistant .pa-msg-bubble {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(74,210,245,0.18);
      color: #E2EAF4; border-bottom-left-radius: 3px;
    }
    .pa-msg-bubble h3 { font-family: 'Syne',sans-serif; font-weight: 700; margin: 12px 0 6px; color: #4AD2F5; font-size: 14px; }
    .pa-msg-bubble h4 { font-weight: 600; margin: 10px 0 4px; color: #FDB338; font-size: 13px; }
    .pa-msg-bubble strong { color: #4AD2F5; font-weight: 600; }
    .pa-msg-bubble ul, .pa-msg-bubble ol { padding-left: 18px; margin: 6px 0; }
    .pa-msg-bubble li { margin-bottom: 4px; }
    .pa-msg-bubble p { margin-bottom: 6px; }
    .pa-msg-bubble code { background: rgba(74,210,245,0.1); border: 1px solid rgba(74,210,245,0.2); padding: 1px 5px; border-radius: 3px; font-size: 12px; font-family: monospace; }
    .pa-msg-bubble pre { background: rgba(0,0,0,0.3); border: 1px solid rgba(74,210,245,0.18); padding: 12px; border-radius: 6px; overflow-x: auto; margin: 8px 0; font-size: 12px; font-family: monospace; }
    .pa-msg-bubble table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 12px; }
    .pa-msg-bubble th { background: rgba(2,81,150,0.4); padding: 6px 10px; text-align: left; color: #4AD2F5; font-weight: 600; }
    .pa-msg-bubble td { padding: 6px 10px; border-bottom: 1px solid rgba(74,210,245,0.08); }
    .pa-msg-bubble tr:hover td { background: rgba(74,210,245,0.04); }

    /* ── Thinking ── */
    .pa-thinking { display: flex; align-items: center; gap: 8px; color: #8B9DB5; font-size: 13px; }
    .pa-dots { display: flex; gap: 4px; }
    .pa-dot { width: 6px; height: 6px; border-radius: 50%; background: #4AD2F5; animation: dotbounce 1.2s ease-in-out infinite; }
    .pa-dot:nth-child(2) { animation-delay: 0.2s; }
    .pa-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes dotbounce { 0%,80%,100%{opacity:0.2;transform:scale(0.8)} 40%{opacity:1;transform:scale(1)} }

    /* ── Input ── */
    .pa-input-area {
      padding: 16px 24px; border-top: 1px solid rgba(74,210,245,0.18);
      background: rgba(14,26,43,0.8); backdrop-filter: blur(12px); flex-shrink: 0;
    }
    .pa-input-row { display: flex; gap: 10px; align-items: flex-end; }
    .pa-textarea {
      flex: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(74,210,245,0.18);
      border-radius: 10px; padding: 11px 14px; color: #F4F8FC;
      font-family: 'DM Sans', sans-serif; font-size: 13.5px;
      resize: none; min-height: 44px; max-height: 160px; outline: none;
      transition: border-color 0.15s; line-height: 1.5;
    }
    .pa-textarea:focus { border-color: rgba(74,210,245,0.4); }
    .pa-textarea::placeholder { color: #4A5568; }
    .pa-send-btn {
      width: 44px; height: 44px; flex-shrink: 0;
      background: linear-gradient(135deg, #025196, #4AD2F5);
      border: none; border-radius: 10px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; transition: all 0.15s; color: white;
    }
    .pa-send-btn:hover { transform: scale(1.05); box-shadow: 0 0 16px rgba(74,210,245,0.3); }
    .pa-send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .pa-input-hint { font-size: 11px; color: #4A5568; margin-top: 6px; text-align: center; }
    .pa-input-hint span { color: #6B7280; }
    .pa-copy-btn {
      background: transparent; border: 1px solid rgba(74,210,245,0.18); color: #8B9DB5;
      padding: 3px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;
      margin-top: 8px; transition: all 0.15s; font-family: 'DM Sans', sans-serif;
    }
    .pa-copy-btn:hover { border-color: #4AD2F5; color: #4AD2F5; }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="pa-header">
    <div class="pa-logo">
      <div class="pa-logo-mark">YK</div>
      <div class="pa-logo-text">Proc<span>Agent</span></div>
      <div class="pa-badge">AGENTIC AI</div>
    </div>
    <div class="pa-header-right">
      <!-- Token Counter -->
      <div class="pa-token-counter" id="tokenCounter" onclick="toggleTokenDetail()">
        <div class="pa-token-icon" id="tokenIcon">⚡</div>
        <div class="pa-token-main">
          <div class="pa-token-total">
            <span class="pa-token-used" id="tokenUsed">0</span>
            <span class="pa-token-sep"> dari </span>
            <span class="pa-token-limit">200,000</span>
            <span class="pa-token-label"> token</span>
          </div>
          <div class="pa-token-bar-wrap">
            <div class="pa-token-bar-fill" id="tokenBar" style="width:0%"></div>
          </div>
        </div>
        <div class="pa-token-warn-badge" id="warnBadge" style="display:none"></div>
        <div class="pa-token-detail" id="tokenDetail">
          <div class="pa-token-row">
            <span>↑ Input</span><span class="pa-token-val in" id="detailInput">0</span>
          </div>
          <div class="pa-token-row">
            <span>↓ Output</span><span class="pa-token-val out" id="detailOutput">0</span>
          </div>
          <div class="pa-token-row">
            <span>API Calls</span><span class="pa-token-val" id="detailCalls">0</span>
          </div>
          <div class="pa-token-row">
            <span>Penggunaan</span><span class="pa-token-val" id="detailPct">0%</span>
          </div>
          <div class="pa-token-row border-top">
            <span>Context limit</span><span class="pa-token-val">200,000</span>
          </div>
          <div class="pa-token-alert" id="tokenAlert" style="display:none"></div>
          <div class="pa-token-reset" onclick="resetTokens(event)">Reset counter</div>
        </div>
      </div>
      <div class="pa-status">
        <div class="pa-status-dot"></div>
        AI Engine Active
      </div>
    </div>
  </header>

  <!-- Body -->
  <div class="pa-body">
    <!-- Sidebar -->
    <aside class="pa-sidebar" id="sidebar"></aside>

    <!-- Main -->
    <main class="pa-main">
      <div class="pa-agent-header" id="agentHeader"></div>
      <div class="pa-messages" id="messages"></div>
      <div class="pa-input-area">
        <div class="pa-input-row">
          <textarea class="pa-textarea" id="inputBox" placeholder="Ketik pesan..." rows="1"
            oninput="autoResize(this)" onkeydown="handleKey(event)"></textarea>
          <button class="pa-send-btn" id="sendBtn" onclick="sendMessage()">↑</button>
        </div>
        <div class="pa-input-hint"><span>Enter</span> kirim · <span>Shift+Enter</span> baris baru · Powered by Claude AI via Cloudflare</div>
      </div>
    </main>
  </div>

  <script>
    // ── Config ──────────────────────────────────────────────────────────────
    const WORKER_URL = "https://procagent-proxy-01.tommi-khrisna.workers.dev";

    const AGENTS = [
      { id: "rfp",        icon: "📋", label: "RFP/RFQ Builder",    color: "#4AD2F5", desc: "Draft RFP atau RFQ dokumen pengadaan" },
      { id: "vendor",     icon: "🔍", label: "Vendor Evaluator",    color: "#FDB338", desc: "Scoring & perbandingan vendor" },
      { id: "hps",        icon: "💰", label: "HPS Estimator",       color: "#EDE832", desc: "Kalkulasi HPS / OE estimate" },
      { id: "contract",   icon: "📝", label: "Contract Reviewer",   color: "#4AD2F5", desc: "Review & redline kontrak" },
      { id: "sla",        icon: "📊", label: "SLA Designer",        color: "#FDB338", desc: "Desain SLA framework & KPI" },
      { id: "risk",       icon: "⚠️", label: "Risk Analyzer",       color: "#E8232A", desc: "Identifikasi & mitigasi risiko supply" },
      { id: "savings",    icon: "📈", label: "Savings Planner",     color: "#EDE832", desc: "Model inisiatif cost-saving" },
      { id: "negotation", icon: "🤝", label: "Negotiation Coach",   color: "#4AD2F5", desc: "Taktik & strategi BATNA negosiasi" },
      { id: "chat",       icon: "💬", label: "Free Consult",        color: "#8B9DB5", desc: "Tanya apa saja seputar procurement" },
    ];

    const SYSTEM_PROMPTS = {
      rfp: `You are a senior procurement specialist at an Indonesian payment technology company. 
Draft professional RFP/RFQ documents in Bahasa Indonesia or English as requested.
Include: Executive Summary, Scope of Work, Technical Requirements, Commercial Terms, 
Evaluation Criteria, Submission Requirements, Timeline. 
Use precise procurement language aligned with LKPP and best practice standards.
Format with clear numbered sections. Be thorough and specific.`,

      vendor: `You are a procurement vendor evaluation expert. 
Analyze vendor proposals and create structured scoring matrices.
Cover: Technical Capability (30%), Financial Stability (20%), Experience (20%), 
Price Competitiveness (20%), Compliance & Risk (10%).
Provide numerical scores, clear rationale, and a final recommendation.
Flag red flags. Be objective and defensible. Present as a structured evaluation report.`,

      hps: `You are an HPS (Harga Perkiraan Sendiri) specialist for Indonesian government and corporate procurement.
Calculate fair market price estimates based on: market survey methodology, BPS data references, 
historical contract data, and cost build-up analysis.
Show your methodology transparently. Include: direct costs, overhead, profit margin (max 15% for goods, 
10% for services per LKPP), and PPN 11%.
Always cite your data sources and assumptions clearly.`,

      contract: `You are a procurement contract specialist with expertise in Indonesian contract law (KUHPerdata) 
and commercial contracts.
Review contracts for: unfavorable payment terms, liability gaps, IP ownership issues, 
termination clauses, SLA/penalty provisions, governing law, and force majeure.
Redline problematic clauses and suggest alternative language.
Flag high-risk items in RED. Medium risk in AMBER. Present findings in a structured review table.`,

      sla: `You are an SLA design expert for technology and services procurement.
Design comprehensive SLA frameworks including: service definitions, measurement methodology, 
KPI targets, reporting cadence, penalty/reward mechanisms, escalation paths, and review governance.
Align with Indonesian procurement regulation and industry benchmarks.
Output a structured SLA template with specific, measurable metrics.`,

      risk: `You are a supply chain and procurement risk specialist.
Conduct thorough risk assessment across: supplier concentration, geopolitical risk, 
financial stability, compliance (regulatory, ESG), operational continuity, and cyber security.
Use a 5x5 risk matrix (Likelihood x Impact). Provide mitigation strategies for each risk.
Present as a risk register with risk ratings: Critical / High / Medium / Low.`,

      savings: `You are a procurement cost optimization expert with expertise across retail, manufacturing, 
technology, and payment services.
Model cost-saving initiatives using: strategic sourcing, demand aggregation, specification optimization, 
payment term arbitrage, vendor consolidation, and process efficiency.
Quantify savings potential with confidence levels. Build a 12-month savings roadmap.
Show NPV and payback period where applicable.`,

      negotation: `You are an elite procurement negotiation coach.
Provide tactical negotiation strategies including: BATNA analysis, ZOPA mapping, 
concession planning, anchoring strategy, and closing tactics.
Draw from Harvard Negotiation principles. Give specific scripts and counter-arguments.
Tailor advice to Indonesian business culture where relevant.`,

      chat: `You are ProcAgent — an expert AI procurement consultant with 15+ years experience across 
retail, manufacturing, technology, and payment services in Indonesia and Southeast Asia.
You help procurement professionals with strategy, sourcing, contracts, compliance, cost optimization, 
and vendor management.
Respond in the same language the user writes (Bahasa Indonesia or English).
Be specific, practical, and reference Indonesian regulations (Perpres, LKPP) when relevant.
You work at PT Mitra Transaksi Indonesia in the payment technology sector.`,
    };

    const QUICK_PROMPTS = {
      rfp:        ["Draft RFP untuk pengadaan 500 unit EDC terminal", "Buat RFQ untuk jasa maintenance server 1 tahun", "Create RFP for cloud infrastructure managed services"],
      vendor:     ["Evaluasi 3 vendor IT hardware berdasarkan proposal", "Score vendor: PT A (60), PT B (75), PT C (68)", "Bandingkan dua vendor logistik berdasarkan harga dan kapasitas"],
      hps:        ["Hitung HPS untuk pengadaan 200 unit printer thermal", "Estimate OE untuk layanan cloud hosting 1 tahun", "HPS untuk kontrak maintenance EDC terminal"],
      contract:   ["Review klausul pembayaran: net 90 hari", "Redline klausul terminasi yang terlalu sepihak", "Analisa klausul force majeure dalam kontrak vendor"],
      sla:        ["Desain SLA untuk layanan IT helpdesk Tier 1-3", "Buat SLA framework untuk layanan pengiriman logistik", "Buat KPI scorecard untuk vendor payment gateway"],
      risk:       ["Risk assessment untuk strategi single-source vendor", "Analisa risiko vendor dengan kondisi keuangan lemah", "Supply chain risk untuk komponen hardware impor"],
      savings:    ["Model savings dari konsolidasi vendor 5 menjadi 2", "Rencana penghematan biaya kategori pengadaan IT", "Identifikasi savings dari optimasi payment term"],
      negotation: ["Strategi negosiasi penurunan harga 15% tanpa kehilangan vendor", "BATNA strategy untuk negosiasi perpanjangan kontrak", "Taktik negosiasi dengan vendor yang monopolistik"],
      chat:       ["Apa perbedaan pengadaan langsung vs tender?", "Bagaimana menyusun program transformasi procurement?", "Best practice mengelola hubungan vendor strategis"],
    };

    // ── State ────────────────────────────────────────────────────────────────
    let activeAgent = "chat";
    let conversations = {};
    let loading = false;
    let tokenStats = { input: 0, output: 0, calls: 0 };

    // ── Token Counter ────────────────────────────────────────────────────────
    function updateTokenUI() {
      const total = tokenStats.input + tokenStats.output;
      const pct = (total / 200000) * 100;
      const level = pct >= 90 ? "danger" : pct >= 70 ? "warning" : "normal";

      document.getElementById("tokenUsed").textContent = total.toLocaleString("id-ID");
      document.getElementById("tokenBar").style.width = Math.min(pct, 100) + "%";
      document.getElementById("detailInput").textContent = tokenStats.input.toLocaleString("id-ID");
      document.getElementById("detailOutput").textContent = tokenStats.output.toLocaleString("id-ID");
      document.getElementById("detailCalls").textContent = tokenStats.calls;
      document.getElementById("detailPct").textContent = pct.toFixed(1) + "%";

      const counter = document.getElementById("tokenCounter");
      const used = document.getElementById("tokenUsed");
      const bar = document.getElementById("tokenBar");
      const badge = document.getElementById("warnBadge");
      const alert = document.getElementById("tokenAlert");
      const pctEl = document.getElementById("detailPct");
      const icon = document.getElementById("tokenIcon");

      counter.className = "pa-token-counter" + (level !== "normal" ? " " + level : "");
      used.className = "pa-token-used" + (level !== "normal" ? " " + level : "");
      bar.className = "pa-token-bar-fill" + (level !== "normal" ? " " + level : "");
      pctEl.className = "pa-token-val" + (level !== "normal" ? " " + level : "");

      if (level === "normal") {
        icon.textContent = "⚡"; badge.style.display = "none"; alert.style.display = "none";
      } else {
        icon.textContent = level === "danger" ? "🔴" : "🟡";
        badge.style.display = "inline-block";
        badge.className = "pa-token-warn-badge " + level;
        badge.textContent = level === "danger" ? "90%+" : "70%+";
        alert.style.display = "block";
        alert.className = "pa-token-alert " + level;
        alert.textContent = level === "danger"
          ? "⚠️ Mendekati batas! Mulai percakapan baru."
          : "⚡ Penggunaan tinggi, pertimbangkan reset.";
      }
    }

    function toggleTokenDetail() {
      document.getElementById("tokenDetail").classList.toggle("open");
    }

    function resetTokens(e) {
      e.stopPropagation();
      tokenStats = { input: 0, output: 0, calls: 0 };
      updateTokenUI();
    }

    document.addEventListener("click", function(e) {
      const counter = document.getElementById("tokenCounter");
      if (!counter.contains(e.target)) {
        document.getElementById("tokenDetail").classList.remove("open");
      }
    });

    // ── Markdown renderer ────────────────────────────────────────────────────
    function renderMarkdown(text) {
      if (!text) return "";
      let html = text
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/```([\s\S]*?)```/g, "<pre><code>$1</code></pre>")
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/\*\*\*(.+?)\*\*\*/g, "<strong><em>$1</em></strong>")
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/\*(.+?)\*/g, "<em>$1</em>")
        .replace(/^### (.+)$/gm, "<h4>$1</h4>")
        .replace(/^## (.+)$/gm, "<h3>$1</h3>")
        .replace(/^# (.+)$/gm, "<h3>$1</h3>")
        .replace(/^\|(.+)\|$/gm, function(m) {
          const cells = m.split("|").filter(c => c.trim() && !c.match(/^[-: ]+$/));
          if (!cells.length) return "";
          return "<tr>" + cells.map(c => "<td>" + c.trim() + "</td>").join("") + "</tr>";
        })
        .replace(/(<tr>[\s\S]*?<\/tr>)/g, "<table>$1</table>")
        .replace(/^[-*] (.+)$/gm, "<li>$1</li>")
        .replace(/^\d+\. (.+)$/gm, "<li>$1</li>")
        .replace(/(<li>[\s\S]*?<\/li>)/g, "<ul>$1</ul>")
        .replace(/\n\n/g, "</p><p>")
        .replace(/\n/g, "<br/>");
      return "<p>" + html + "</p>";
    }

    // ── Sidebar ──────────────────────────────────────────────────────────────
    function renderSidebar() {
      const sidebar = document.getElementById("sidebar");
      sidebar.innerHTML = '<div class="pa-sidebar-label">Agents</div>' +
        AGENTS.map(a => `
          <button class="pa-agent-btn${a.id === activeAgent ? " active" : ""}"
            style="--ac:${a.color}"
            onclick="switchAgent('${a.id}')"
            title="${a.desc}">
            <span class="pa-agent-icon">${a.icon}</span>
            <span class="pa-agent-name">${a.label}</span>
          </button>`).join("");
    }

    // ── Agent Header ─────────────────────────────────────────────────────────
    function renderAgentHeader() {
      const a = AGENTS.find(x => x.id === activeAgent);
      document.getElementById("agentHeader").innerHTML = `
        <div class="pa-agent-title">
          <div class="pa-agent-title-icon" style="background:${a.color}22">${a.icon}</div>
          ${a.label}
        </div>
        <div class="pa-agent-desc">${a.desc}</div>`;
    }

    // ── Messages ─────────────────────────────────────────────────────────────
    function renderMessages() {
      const msgs = conversations[activeAgent] || [];
      const box = document.getElementById("messages");

      if (!msgs.length) {
        const a = AGENTS.find(x => x.id === activeAgent);
        const prompts = (QUICK_PROMPTS[activeAgent] || [])
          .map(p => `<button class="pa-quick-btn" onclick="sendQuick('${p.replace(/'/g,"\\'")}')">` + p + `</button>`).join("");
        box.innerHTML = `
          <div class="pa-welcome">
            <div class="pa-welcome-icon">${a.icon}</div>
            <h2>Siap untuk <span>${a.label}</span></h2>
            <p>${a.desc}. Pilih prompt cepat atau ketik pertanyaanmu.</p>
            <div class="pa-quick-prompts">${prompts}</div>
          </div>`;
        return;
      }

      box.innerHTML = msgs.map((m, i) => `
        <div class="pa-msg ${m.role}">
          <div class="pa-msg-avatar">${m.role === "assistant" ? "🤖" : "👤"}</div>
          <div>
            <div class="pa-msg-bubble">${m.role === "assistant" ? renderMarkdown(m.content) : escapeHtml(m.content)}</div>
            ${m.role === "assistant" ? `<button class="pa-copy-btn" onclick="copyMsg(${i})">Copy</button>` : ""}
          </div>
        </div>`).join("");

      box.scrollTop = box.scrollHeight;
    }

    function appendThinking() {
      const box = document.getElementById("messages");
      const div = document.createElement("div");
      div.className = "pa-msg assistant"; div.id = "thinking";
      div.innerHTML = `<div class="pa-msg-avatar">🤖</div>
        <div class="pa-msg-bubble">
          <div class="pa-thinking">
            <div class="pa-dots"><div class="pa-dot"></div><div class="pa-dot"></div><div class="pa-dot"></div></div>
            Menganalisis...
          </div>
        </div>`;
      box.appendChild(div);
      box.scrollTop = box.scrollHeight;
    }

    function removeThinking() {
      const t = document.getElementById("thinking");
      if (t) t.remove();
    }

    function escapeHtml(t) {
      return t.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    }

    function copyMsg(idx) {
      const msgs = conversations[activeAgent] || [];
      if (msgs[idx]) navigator.clipboard.writeText(msgs[idx].content).catch(() => {});
    }

    // ── Switch Agent ─────────────────────────────────────────────────────────
    function switchAgent(id) {
      activeAgent = id;
      renderSidebar();
      renderAgentHeader();
      renderMessages();
      document.getElementById("inputBox").placeholder = "Tanya " + AGENTS.find(x=>x.id===id).label + "...";
    }

    // ── Send ─────────────────────────────────────────────────────────────────
    function sendQuick(text) { if (!loading) doSend(text); }

    function sendMessage() {
      const input = document.getElementById("inputBox");
      const text = input.value.trim();
      if (!text || loading) return;
      input.value = ""; input.style.height = "44px";
      doSend(text);
    }

    async function doSend(text) {
      loading = true;
      document.getElementById("sendBtn").disabled = true;

      if (!conversations[activeAgent]) conversations[activeAgent] = [];
      conversations[activeAgent].push({ role: "user", content: text });
      renderMessages();
      appendThinking();

      try {
        const res = await fetch(WORKER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model: "claude-sonnet-4-6",
            max_tokens: 1000,
            system: SYSTEM_PROMPTS[activeAgent],
            messages: conversations[activeAgent].map(m => ({ role: m.role, content: m.content })),
          }),
        });

        const data = await res.json();
        const reply = (data.content || []).find(b => b.type === "text")?.text || "Tidak ada respons.";
        conversations[activeAgent].push({ role: "assistant", content: reply });

        if (data.usage) {
          tokenStats.input  += data.usage.input_tokens  || 0;
          tokenStats.output += data.usage.output_tokens || 0;
          tokenStats.calls  += 1;
          updateTokenUI();
        }
      } catch (err) {
        conversations[activeAgent].push({ role: "assistant", content: "**Error:** " + err.message + "\n\nPastikan Cloudflare Worker aktif dan API key sudah di-set." });
      }

      loading = false;
      document.getElementById("sendBtn").disabled = false;
      removeThinking();
      renderMessages();
    }

    // ── Input helpers ────────────────────────────────────────────────────────
    function handleKey(e) {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    }

    function autoResize(el) {
      el.style.height = "44px";
      el.style.height = Math.min(el.scrollHeight, 160) + "px";
    }

    // ── Init ─────────────────────────────────────────────────────────────────
    renderSidebar();
    renderAgentHeader();
    renderMessages();
    updateTokenUI();
  </script>
</body>
</html>
